{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Records Processed (Total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "default" },
      "targets": [
        {
          "expr": "sum(pipeline_records_processed_total)",
          "legendFormat": "Total Records"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 1000 },
              { "color": "green", "value": 10000 }
            ]
          }
        }
      }
    },
    {
      "title": "Records by Layer",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "default" },
      "targets": [
        {
          "expr": "sum by (layer) (rate(pipeline_records_processed_total[5m]))",
          "legendFormat": "{{layer}}"
        }
      ]
    },
    {
      "title": "Data Quality Score",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "default" },
      "targets": [
        {
          "expr": "avg(pipeline_data_quality_score)",
          "legendFormat": "Avg Quality"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      }
    },
    {
      "title": "Last Run Timestamp",
      "type": "table",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "default" },
      "targets": [
        {
          "expr": "pipeline_last_run_timestamp",
          "legendFormat": "{{layer}} / {{asset}}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "title": "Processing Duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "default" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(pipeline_processing_duration_seconds_bucket[15m]))",
          "legendFormat": "{{asset}} p95"
        }
      ]
    },
    {
      "title": "Errors by Asset",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "default" },
      "targets": [
        {
          "expr": "sum by (asset) (rate(pipeline_errors_total[15m]))",
          "legendFormat": "{{asset}}"
        }
      ]
    },
    {
      "title": "Records by Symbol",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "default" },
      "targets": [
        {
          "expr": "sum by (symbol) (pipeline_records_processed_total)",
          "legendFormat": "{{symbol}}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["crypto", "pipeline", "overview"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Crypto Pipeline Overview",
  "uid": "crypto-pipeline-overview",
  "version": 1
}
