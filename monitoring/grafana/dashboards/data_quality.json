{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "title": "Quality Score by Symbol",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "default" },
      "targets": [
        {
          "expr": "pipeline_data_quality_score",
          "legendFormat": "{{layer}} / {{symbol}}"
        }
      ]
    },
    {
      "title": "Freshness (seconds since last record)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "default" },
      "targets": [
        {
          "expr": "time() - pipeline_last_run_timestamp",
          "legendFormat": "{{layer}} / {{asset}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1800 },
              { "color": "red", "value": 3600 }
            ]
          }
        }
      }
    },
    {
      "title": "Valid Record Percentage",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "default" },
      "targets": [
        {
          "expr": "pipeline_data_quality_score",
          "legendFormat": "{{symbol}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "orange", "value": 0.5 },
              { "color": "yellow", "value": 0.8 },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      }
    },
    {
      "title": "Error Rate by Asset",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "default" },
      "targets": [
        {
          "expr": "rate(pipeline_errors_total[10m])",
          "legendFormat": "{{asset}} ({{error_type}})"
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["crypto", "quality"],
  "time": { "from": "now-12h", "to": "now" },
  "title": "Data Quality Dashboard",
  "uid": "crypto-data-quality",
  "version": 1
}
